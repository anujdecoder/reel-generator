    },
    {
      "content": "Think of a Function\nas a temporary Box \n\nWhatever is created inside...\nUsually dies inside.",
      "animationType": "typewriter",
      "fontSize": 80,
      "fontColor": "#FFFFFF",
      "fontWeight": "normal",
